{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiredchaos.github.io/hermes-skinscape/worlds/world-prompt.schema.json",
  "title": "Hermes Skinscape World Prompt",
  "description": "A provenance-aware contract for generating a cinematic world from an upstream Hermes terminal skin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "provenance",
    "identity",
    "palette",
    "scene",
    "camera",
    "render",
    "continuity",
    "generation",
    "assets",
    "legal",
    "status"
  ],
  "properties": {
    "version": { "const": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skin_id", "source_kind", "world_origin", "source_description"],
      "properties": {
        "skin_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "source_kind": { "const": "upstream-hermes-skin" },
        "world_origin": {
          "enum": ["upstream-world", "generated-from-upstream-theme", "community-authored"]
        },
        "source_description": { "type": "string", "minLength": 1 },
        "source_repository": { "type": "string", "format": "uri" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_id", "title", "category", "logline", "cinematic_pack"],
      "properties": {
        "world_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1 },
        "logline": { "type": "string", "minLength": 1, "maxLength": 300 },
        "cinematic_pack": {
          "enum": ["agentropolis-city", "void-frontier", "neutral-environment"]
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit_from_skin", "background", "primary", "secondary", "accent"],
      "properties": {
        "inherit_from_skin": { "type": "boolean" },
        "background": { "$ref": "#/$defs/hexColor" },
        "primary": { "$ref": "#/$defs/hexColor" },
        "secondary": { "$ref": "#/$defs/hexColor" },
        "accent": { "$ref": "#/$defs/hexColor" },
        "protected_identity_colors": {
          "type": "array",
          "items": { "enum": ["primary", "secondary", "accent", "background"] },
          "uniqueItems": true
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "architecture",
        "landmark",
        "sky",
        "ground",
        "atmosphere",
        "motion",
        "inhabitants",
        "props"
      ],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "landmark": { "type": "string", "minLength": 1 },
        "sky": { "type": "string", "minLength": 1 },
        "ground": { "type": "string", "minLength": 1 },
        "atmosphere": { "type": "string", "minLength": 1 },
        "time_of_day": { "type": "string" },
        "weather": { "type": "string" },
        "motion": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "inhabitants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "props": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot", "lens_mm", "movement", "composition", "aspect_ratios"],
      "properties": {
        "shot": { "type": "string", "minLength": 1 },
        "lens_mm": { "type": "number", "minimum": 10, "maximum": 200 },
        "movement": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "aspect_ratios": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["16:9", "9:16", "1:1", "4:5", "21:9"] },
          "uniqueItems": true
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["medium", "style", "lighting", "materials", "detail"],
      "properties": {
        "medium": { "enum": ["3d-render", "concept-art", "photoreal", "illustration", "procedural-webgl"] },
        "style": { "type": "string", "minLength": 1 },
        "lighting": { "type": "string", "minLength": 1 },
        "materials": { "type": "string", "minLength": 1 },
        "detail": { "enum": ["preview", "production", "hero"] }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_skin_palette", "preserve_user_identity", "protected_tokens"],
      "properties": {
        "preserve_skin_palette": { "type": "boolean" },
        "preserve_user_identity": { "type": "boolean" },
        "protected_tokens": {
          "type": "array",
          "items": { "enum": ["agent_name", "avatar", "logo", "primary_color", "secondary_color", "background"] },
          "uniqueItems": true
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["still_prompt", "motion_prompt", "three_d_prompt", "negative_prompt"],
      "properties": {
        "still_prompt": { "type": "string", "minLength": 20 },
        "motion_prompt": { "type": "string", "minLength": 20 },
        "three_d_prompt": { "type": "string", "minLength": 20 },
        "negative_prompt": { "type": "string", "minLength": 10 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero", "background", "thumbnail", "motion_loop", "scene_model"],
      "properties": {
        "hero": { "$ref": "#/$defs/assetSlot" },
        "background": { "$ref": "#/$defs/assetSlot" },
        "thumbnail": { "$ref": "#/$defs/assetSlot" },
        "motion_loop": { "$ref": "#/$defs/assetSlot" },
        "scene_model": { "$ref": "#/$defs/assetSlot" }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originality", "prohibited_references", "user_asset_attestation_required"],
      "properties": {
        "originality": { "const": "strict-original-expression" },
        "prohibited_references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "user_asset_attestation_required": { "type": "boolean" }
      }
    },
    "status": {
      "enum": ["prompt-ready", "generating", "generated", "approved", "rejected"]
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "assetSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path"],
      "properties": {
        "status": { "enum": ["missing", "generated", "approved"] },
        "path": { "type": ["string", "null"] },
        "checksum": { "type": ["string", "null"] }
      }
    }
  }
}
